# Copie para .env (não versionado). Só a chave anon/publishable: ela vai para o bundle público.
# NUNCA coloque aqui a service_role, o token de acesso da conta (SUPABASE_ACCESS_TOKEN) nem a senha do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Só para os scripts sb:* e db:* (nunca vão para o bundle; o prefixo VITE_ só vale para o ID do projeto, que é público).
VITE_SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
