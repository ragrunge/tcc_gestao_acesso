{
  "name": "gestao-acesso",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run lint && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run format:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "sb:login": "dotenv -- sh -c 'supabase login --token $SUPABASE_ACCESS_TOKEN'",
    "sb:link": "dotenv -- sh -c 'supabase link --project-ref \"$VITE_SUPABASE_PROJECT_ID\"'",
    "db:push:dry": "dotenv -- sh -c 'supabase db push --dry-run --db-url \"$SUPABASE_DB_URL\"'",
    "db:push": "dotenv -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL\"'",
    "sb:sindico": "dotenv -- node --disable-warning=ExperimentalWarning scripts/sindico/main.ts",
    "popular:dry": "dotenv -- node --disable-warning=ExperimentalWarning scripts/popular/main.ts --dry-run",
    "popular": "dotenv -- node --disable-warning=ExperimentalWarning scripts/popular/main.ts",
    "fn:deploy:all": "dotenv -- supabase functions deploy",
    "gen:types": "dotenv -- sh -c 'supabase gen types typescript --project-id \"$VITE_SUPABASE_PROJECT_ID\" --schema api > src/integrations/supabase/type.tmp && mv src/integrations/supabase/type.tmp src/integrations/supabase/type.ts'",
    "db:mig:new": "supabase migration new",
    "check:migrations": "node scripts/checar-migrations.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-radio-group": "1.4.8",
    "@radix-ui/react-slot": "1.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "cmdk": "1.1.1",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.12",
    "workbox-window": "7.4.1"
  }
}
