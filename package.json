{
  "name": "gestao-acesso",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm test -w packages/domain",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w packages/domain",
    "test:supabase": "vitest run --config vitest.supabase.config.ts",
    "sb:login": "dotenv -- sh -c 'supabase login --token $SUPABASE_ACCESS_TOKEN'",
    "sb:link": "dotenv -- sh -c 'supabase link --project-ref \"$VITE_SUPABASE_PROJECT_ID\"'",
    "db:push:dry": "dotenv -- sh -c 'supabase db push --dry-run --db-url \"$SUPABASE_DB_URL\"'",
    "db:push": "dotenv -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL\"'",
    "fn:deploy:all": "dotenv -- supabase functions deploy",
    "db:start": "supabase start"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@portaria/domain": "*",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-radio-group": "1.4.8",
    "@radix-ui/react-slot": "1.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "cmdk": "1.1.1",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^8.0.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^2.1.9",
    "workbox-window": "7.4.1"
  }
}
